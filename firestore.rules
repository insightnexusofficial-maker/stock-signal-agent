rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    match /stocks/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /state/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /snapshots/{document=**} {
      allow read: if false;
      allow write: if false;
    }
    
    match /fcm_tokens/{token} {
      // 토큰 값 자체가 문서 ID인 경우에만 본인 승인 상태를 조회할 수 있다.
      // 일반 사용자는 자기 토큰만 조회하고, 관리자만 승인 목록을 관리한다.
      allow get: if true;
      allow list: if isAdmin();
      // 기존 등록 토큰을 가진 클라이언트는 수신 설정만 바꿀 수 있다.
      // 승인·닉네임·토큰·등록 시각을 함께 변경하는 요청은 허용하지 않는다.
      function updatesPushPreferenceOnly() {
        return resource.data.token == token
               && request.resource.data.token == resource.data.token
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['push_enabled', 'push_updated_at'])
               && request.resource.data.push_enabled is bool
               && request.resource.data.push_updated_at is string
               && request.resource.data.push_updated_at.size() <= 40;
      }
      allow update: if (isAdmin()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
                       && request.resource.data.approved is bool)
                    || updatesPushPreferenceOnly();
      allow delete: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly([
                      'token', 'nickname', 'registered_at', 'createdAt', 'approved',
                      'push_enabled', 'push_updated_at'
                    ])
                  && request.resource.data.keys().hasAll([
                      'token', 'nickname', 'registered_at', 'createdAt', 'approved'
                    ])
                  && request.resource.data.token == token
                  && request.resource.data.token is string
                  && request.resource.data.nickname is string
                  && request.resource.data.nickname.size() <= 30
                  && request.resource.data.registered_at is string
                  && request.resource.data.createdAt is timestamp
                  && request.resource.data.approved == false
                  && (!('push_enabled' in request.resource.data)
                      || request.resource.data.push_enabled is bool)
                  && (!('push_updated_at' in request.resource.data)
                      || (request.resource.data.push_updated_at is string
                          && request.resource.data.push_updated_at.size() <= 40));
    }
  }
}
